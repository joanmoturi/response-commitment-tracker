# Copy to .env. Generate independent random secrets; never commit .env.
POSTGRES_USER=app
POSTGRES_DB=app
POSTGRES_PASSWORD=
JWT_SECRET=
ENVIRONMENT=development
FRONTEND_URL=http://localhost:3000
CORS_ORIGINS=["http://localhost:3000"]
COOKIE_SECURE=false
LOCAL_REGISTRATION_ENABLED=true
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
# Optional OIDC. Register the callback URI described in backend/.env.example.
OIDC_ISSUER=
OIDC_CLIENT_ID=
OIDC_CLIENT_SECRET=
OIDC_REDIRECT_URI=http://localhost:3000/api/v1/auth/oidc/callback
